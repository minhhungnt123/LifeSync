{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LifeSync AI",
  "version": "1.0.0",
  "identifier": "com.lifesync.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeSync AI - Productivity & Wellness Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 LifeSync Team. All rights reserved.",
    "shortDescription": "LifeSync AI - Productivity & Wellness Companion",
    "longDescription": "LifeSync AI is a smart personal productivity platform with an integrated Heartcare AI assistant, managing schedules, nutrition, and wellness.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/minhhungnt123/LifeSync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldUUWFBWldOdk9KUVpQSnN4eTFXQ3RkdmR1S1ZqSHJtQ2p5S01HMGxQWFRtVXZ1UlpGQUFBQUEK"
    }
  }
}
